# Copy to server/.env (never commit it) or set these as environment variables on your host.

PORT=8080

# Firebase: the web API key is in Firebase console > Project settings > General.
FIREBASE_WEB_API_KEY=
# Firestore access. Firebase console > Project settings > Service accounts > Generate new private key.
# Either point to the downloaded file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# ...or paste the whole JSON on one line instead (useful on hosts without file storage):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Any long random string. Signs referral tokens. Changing it invalidates tokens already issued.
ATTRIBUTION_SECRET=
# Shopify admin > Settings > Notifications > Webhooks: the signing secret shown on that page.
SHOPIFY_WEBHOOK_SECRET=

# Shopify Dev Dashboard app (creates the influencers' coupon codes).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-07

# Only needed if the site is hosted somewhere else than this server (comma-separated origins).
# ALLOWED_ORIGINS=https://creatormoves365.in
# Folder of the built site. Defaults to ../dist
# STATIC_DIR=
# PROMOTE_EVERY_MINUTES=60

# E-book library (customers open what they bought). Only needed if your store uses classic (email + password) accounts:
# SHOPIFY_STOREFRONT_TOKEN=   (the same public Storefront token used in the site's VITE_SHOPIFY_STOREFRONT_TOKEN)
# Optional: your Customer Account API GraphQL address, if automatic discovery fails:
# SHOPIFY_CUSTOMER_GRAPHQL_URL=
