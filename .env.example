# Copy to .env (never commit .env). Everything here is PUBLIC: Vite ships VITE_* values to the browser.
# Never put an Admin API token or any secret in this file.

# --- Storefront API (products + cart) ---------------------------------------
# Your store's myshopify domain (or the custom domain Shopify serves the API from)
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Shopify admin > Sales channels > Headless > your storefront > Storefront API > Public access token
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional. Defaults to 2026-07.
# VITE_SHOPIFY_API_VERSION=2026-07
# Optional. Locale used only to format prices. Defaults to en-IN.
# VITE_CURRENCY_LOCALE=en-IN

# --- Customer sign-in: new customer accounts (Customer Account API) ---------
# Shopify admin > Headless > Customer Account API settings > Client ID (public client)
VITE_SHOPIFY_CUSTOMER_CLIENT_ID=
# Optional. Copy these from "Application endpoints" in the same settings page.
# Leave blank to discover them automatically from your store domain.
# VITE_SHOPIFY_CUSTOMER_AUTH_URL=
# VITE_SHOPIFY_CUSTOMER_TOKEN_URL=
# VITE_SHOPIFY_CUSTOMER_LOGOUT_URL=
# VITE_SHOPIFY_CUSTOMER_GRAPHQL_URL=

# --- Only if your store STILL uses legacy customer accounts -----------------
# Shopify deprecated them in Feb 2026. Set to "classic" to use email + password forms
# through the Storefront API instead of the secure Shopify sign-in.
# VITE_SHOPIFY_AUTH_MODE=classic

# --- Affiliate / influencer system (partner area at /partner, admin at /admin) -------------
# Leave this unset when the Node server (server/) also serves the site: the browser then calls
# /api on the same domain. Set it only if the site is hosted elsewhere, e.g.
# VITE_AFFILIATE_API_URL=https://api.yourdomain.com/api
# (then add the site's address to ALLOWED_ORIGINS in server/.env)
# VITE_AFFILIATE_API_URL=/api
